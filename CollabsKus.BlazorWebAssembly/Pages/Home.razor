@page "/"
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject KathmanduCalendarService CalendarService
@inject SolarPositionService SolarPositionService
@inject IGeolocationService GeolocationService
@inject IApiLogger ApiLogger
@inject TimeProvider TimeProvider
@inject IJSRuntime JS
@inject IOptions<RefreshOptions> RefreshConfig
@inject IOptions<LocationOptions> LocationConfig
@inject ILogger<Home> Log

<PageTitle>Kathmandu Calendar & Time</PageTitle>

<div class="header">
    <h1>काठमाडौं</h1>
    <div class="subtitle">Kathmandu, Nepal</div>
</div>

@if (StatusMessage is { } message)
{
    <div class="notice" role="status">@message</div>
}

<TimeDisplay CurrentTime="_currentTime" />
<DateCards CalendarData="_calendar?.Data" />
<MoonDisplay MoonPhase="_moonPhase" IsLive="IsMoonLive" />
<Sundisplay Position="_sunPosition" UserPosition="_userSunPosition" IsLive="IsSunLive" />
<CalendarGrid CalendarData="_calendar?.Data" Today="Today" UserLocation="_userLocation" />

<div class="footer">
    Last updated: <span>@_lastUpdate</span>
    @if (!_isOnline)
    {
        <span class="footer-sep">·</span>
        <span class="offline-badge">Offline</span>
    }
    <span class="footer-sep">·</span>
    <a href="/blog" class="footer-link">Blog</a>
    <span class="footer-sep">·</span>
    <a href="https://github.com/collabskus/collabskus.github.io/" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
</div>

@code {
    private const string MoonElementId = "moon-display-root";
    private const string SunElementId = "sun-display-root";

    private readonly CancellationTokenSource _lifetime = new();
    private readonly SemaphoreSlim _calendarGate = new(1, 1);
    private readonly SemaphoreSlim _clockGate = new(1, 1);

    private GeoLocation _homeLocation = default!;
    private GeoLocation? _userLocation;
    private CalendarSnapshot? _calendar;
    private bool _calendarUnavailable;
    private DateOnly _lastCalendarCheck;
    private MoonPhase? _moonPhase;
    private SolarPosition? _sunPosition;
    private SolarPosition? _userSunPosition;
    private DateTime _currentTime;
    private string _lastUpdate = "--";
    private bool _isOnline = true;
    private bool _isTabVisible = true;
    private bool _isMoonInView = true;
    private bool _isSunInView = true;
    private bool _hasLoggedFirstSolarCalc;
    private bool _disposed;
    private DotNetObjectReference<Home>? _dotNetRef;
    private IJSObjectReference? _pageMonitor;

    private bool IsMoonLive => _isTabVisible && _isMoonInView;

    private bool IsSunLive => _isTabVisible && _isSunInView;

    private DateOnly Today => DateOnly.FromDateTime(_currentTime);

    private string? StatusMessage => _calendar switch
    {
        { Source: CalendarDataSource.Stale } stale =>
            $"Calendar could not be updated. Showing saved data from {stale.ForDate:MMMM d, yyyy}.",
        null when _calendarUnavailable =>
            "Calendar data is unavailable right now. Time, moon and sun keep working offline.",
        _ => null
    };

    protected override void OnInitialized()
    {
        _homeLocation = LocationConfig.Value.ToGeoLocation();
        _currentTime = CalendarService.GetCurrentKathmanduTime();
        UpdateMoonPhase();
        UpdateSunPositions();

        var refresh = RefreshConfig.Value;
        _ = RunPeriodicAsync(refresh.ClockTickInterval, OnClockTickAsync);
        _ = RunPeriodicAsync(refresh.ClockSyncCheckInterval, SyncClockAsync);
        _ = RunPeriodicAsync(refresh.CalendarCheckInterval, RefreshCalendarAsync);
        _ = LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        await InitializePageMonitorAsync();
        await ResolveUserLocationAsync();
    }

    [JSInvokable]
    public Task OnVisibilityChanged(bool isVisible)
    {
        _isTabVisible = isVisible;
        if (isVisible)
        {
            _currentTime = CalendarService.GetCurrentKathmanduTime();
            UpdateMoonPhase();
            UpdateSunPositions();
            _ = LoadDataAsync();
        }
        return RenderAsync();
    }

    [JSInvokable]
    public Task OnConnectivityChanged(bool isOnline)
    {
        _isOnline = isOnline;
        if (isOnline)
        {
            _ = LoadDataAsync();
        }
        return RenderAsync();
    }

    [JSInvokable]
    public Task OnMoonInViewChanged(bool isInView)
    {
        _isMoonInView = isInView;
        if (IsMoonLive)
        {
            UpdateMoonPhase();
        }
        return RenderAsync();
    }

    [JSInvokable]
    public Task OnSunInViewChanged(bool isInView)
    {
        _isSunInView = isInView;
        if (IsSunLive)
        {
            UpdateSunPositions();
        }
        return RenderAsync();
    }

    private async Task InitializePageMonitorAsync()
    {
        try
        {
            _pageMonitor = await JS.InvokeAsync<IJSObjectReference>("pageMonitor.init", _dotNetRef);
            _isOnline = await _pageMonitor.InvokeAsync<bool>("isOnline");
            await _pageMonitor.InvokeVoidAsync("observe", MoonElementId, nameof(OnMoonInViewChanged));
            await _pageMonitor.InvokeVoidAsync("observe", SunElementId, nameof(OnSunInViewChanged));
        }
        catch (JSException ex)
        {
            Log.LogWarning(ex, "Page monitor unavailable; live updates stay on.");
            _isTabVisible = true;
            _isMoonInView = true;
            _isSunInView = true;
        }
    }

    private async Task ResolveUserLocationAsync()
    {
        var location = await GeolocationService.GetCurrentLocationAsync(_lifetime.Token);
        if (location is null || _disposed)
        {
            return;
        }

        _userLocation = location;
        UpdateSunPositions();
        await RenderAsync();
    }

    private async Task RunPeriodicAsync(TimeSpan interval, Func<Task> action)
    {
        try
        {
            using var timer = new PeriodicTimer(interval);
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                try
                {
                    await action();
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    Log.LogError(ex, "Periodic update failed.");
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task OnClockTickAsync()
    {
        _currentTime = CalendarService.GetCurrentKathmanduTime();

        if (IsMoonLive)
        {
            UpdateMoonPhase();
        }

        if (IsSunLive)
        {
            UpdateSunPositions();
        }

        if (Today != _lastCalendarCheck)
        {
            _ = RefreshCalendarAsync();
        }

        return RenderAsync();
    }

    private Task LoadDataAsync() => Task.WhenAll(SyncClockAsync(), RefreshCalendarAsync());

    private async Task SyncClockAsync()
    {
        if (!await _clockGate.WaitAsync(0))
        {
            return;
        }

        try
        {
            if (await CalendarService.SyncClockAsync(_lifetime.Token))
            {
                _currentTime = CalendarService.GetCurrentKathmanduTime();
                UpdateLastUpdated();
                await RenderAsync();
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _clockGate.Release();
        }
    }

    private async Task RefreshCalendarAsync()
    {
        if (!await _calendarGate.WaitAsync(0))
        {
            return;
        }

        try
        {
            _lastCalendarCheck = Today;
            var snapshot = await CalendarService.GetCalendarAsync(_lifetime.Token);
            if (snapshot is not null)
            {
                _calendar = snapshot;
            }

            _calendarUnavailable = _calendar is null;
            UpdateLastUpdated();
            await RenderAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _calendarGate.Release();
        }
    }

    private void UpdateMoonPhase()
    {
        _moonPhase = MoonPhaseService.CalculateMoonPhase(TimeProvider.GetUtcNow().UtcDateTime);
    }

    private void UpdateSunPositions()
    {
        var utcNow = TimeProvider.GetUtcNow().UtcDateTime;
        _sunPosition = SolarPositionService.Calculate(utcNow, _homeLocation);
        _userSunPosition = _userLocation is null ? null : SolarPositionService.Calculate(utcNow, _userLocation);

        if (!_hasLoggedFirstSolarCalc)
        {
            _hasLoggedFirstSolarCalc = true;
            LogFirstSolarCalculation(utcNow);
        }
    }

    private void LogFirstSolarCalculation(DateTime utcNow)
    {
        ApiLogger.LogApiRequest("SolarPosition/FirstCalc", new
        {
            kathmanduAltitude = _sunPosition?.Altitude,
            kathmanduAzimuth = _sunPosition?.Azimuth,
            kathmanduSunrise = _sunPosition?.SunriseLocal?.ToString("HH:mm:ss"),
            kathmanduSunset = _sunPosition?.SunsetLocal?.ToString("HH:mm:ss"),
            userLat = _userLocation?.Latitude,
            userLng = _userLocation?.Longitude,
            userAltitude = _userSunPosition?.Altitude,
            userAzimuth = _userSunPosition?.Azimuth,
            utcTimestamp = utcNow.ToString("O")
        }, fromCache: false);
    }

    private void UpdateLastUpdated()
    {
        DateTimeOffset? calendarFetched = _calendar?.FetchedAt;
        DateTimeOffset? clockSynced = CalendarService.LastClockSync;
        DateTimeOffset? latest = calendarFetched > clockSynced || clockSynced is null ? calendarFetched : clockSynced;

        if (latest is null)
        {
            return;
        }

        var local = latest.Value.ToLocalTime();
        _lastUpdate = local.Date == DateTimeOffset.Now.Date
            ? local.ToString("hh:mm:ss tt")
            : local.ToString("MMM d, hh:mm tt");
    }

    private Task RenderAsync() => _disposed ? Task.CompletedTask : InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _lifetime.Cancel();

        if (_pageMonitor is not null)
        {
            try
            {
                await _pageMonitor.InvokeVoidAsync("dispose");
                await _pageMonitor.DisposeAsync();
            }
            catch (JSException)
            {
            }
        }

        _dotNetRef?.Dispose();
    }
}
