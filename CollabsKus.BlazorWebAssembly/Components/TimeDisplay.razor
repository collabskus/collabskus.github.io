@using System.Globalization

<div class="time-display">
    <div class="time">@Format(Hour12):@Format(CurrentTime.Minute):@Format(CurrentTime.Second) <span class="ampm">@AmPm</span></div>
    <div class="time-nepali">@NepaliNumerals.ToNepaliDigits(Hour12):@NepaliNumerals.ToNepaliDigits(CurrentTime.Minute):@NepaliNumerals.ToNepaliDigits(CurrentTime.Second)</div>
</div>

@code {
    [Parameter]
    public DateTime CurrentTime { get; set; }

    private int Hour12 => CurrentTime.Hour % 12 == 0 ? 12 : CurrentTime.Hour % 12;

    private string AmPm => CurrentTime.Hour < 12 ? "AM" : "PM";

    private static string Format(int value) => value.ToString("D2", CultureInfo.InvariantCulture);
}
