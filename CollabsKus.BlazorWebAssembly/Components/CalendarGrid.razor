@inject SolarPositionService SolarService
@inject IOptions<LocationOptions> LocationConfig

@if (CalendarData != null)
{
    <div class="calendar-grid">
        <div class="calendar-header">
            @foreach (var day in CalendarData.WeeksNeMini)
            {
                <div class="day-name">@day</div>
            }
        </div>
        <div class="calendar-days">
            @for (int i = 0; i < CalendarData.Days.Count; i++)
            {
                var idx = i;
                var day = CalendarData.Days[idx];
                <div class="calendar-day @(day.Tag ?? "") @(idx == _selectedDayIndex ? "selected" : "")"
                     @onclick="() => OnDayTapped(idx)">
                    <div class="bs-date">@day.Bs</div>
                    <div class="ad-date">@day.Ad</div>
                    @if (idx == _selectedDayIndex && _selectedHomeSun != null)
                    {
                        <div class="day-sun-info" @onclick:stopPropagation="true">
                            <div class="day-sun-row">
                                <span>🌅 @FormatTimeShort(_selectedHomeSun.SunriseLocal)</span>
                                <span>🌇 @FormatTimeShort(_selectedHomeSun.SunsetLocal)</span>
                            </div>
                            @if (_selectedUserSun != null)
                            {
                                <div class="day-sun-row day-sun-user">
                                    <span>🌅 @FormatTimeShort(_selectedUserSun.SunriseLocal)</span>
                                    <span>🌇 @FormatTimeShort(_selectedUserSun.SunsetLocal)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private static readonly TimeOnly LocalNoon = new(12, 0);

    [Parameter]
    public CalendarData? CalendarData { get; set; }

    [Parameter]
    public DateOnly Today { get; set; }

    [Parameter]
    public GeoLocation? UserLocation { get; set; }

    private GeoLocation _homeLocation = default!;
    private CalendarData? _renderedData;
    private DateOnly _renderedToday;
    private GeoLocation? _renderedUserLocation;
    private int? _selectedDayIndex;
    private SolarPosition? _selectedHomeSun;
    private SolarPosition? _selectedUserSun;

    protected override void OnInitialized()
    {
        _homeLocation = LocationConfig.Value.ToGeoLocation();
    }

    protected override void OnParametersSet()
    {
        bool dataChanged = !ReferenceEquals(CalendarData, _renderedData) || Today != _renderedToday;
        bool userLocationChanged = !Equals(UserLocation, _renderedUserLocation);

        _renderedData = CalendarData;
        _renderedToday = Today;
        _renderedUserLocation = UserLocation;

        if (dataChanged)
        {
            ClearSelection();
        }
        else if (userLocationChanged && _selectedDayIndex is int index)
        {
            CalculateSunForDay(index);
        }
    }

    private void OnDayTapped(int index)
    {
        if (_selectedDayIndex == index)
        {
            ClearSelection();
            return;
        }

        _selectedDayIndex = index;
        CalculateSunForDay(index);
    }

    private void ClearSelection()
    {
        _selectedDayIndex = null;
        _selectedHomeSun = null;
        _selectedUserSun = null;
    }

    private void CalculateSunForDay(int index)
    {
        if (CalendarData == null) return;

        int todayIndex = CalendarProjection.FindTodayIndex(CalendarData);
        if (todayIndex < 0)
        {
            _selectedHomeSun = null;
            _selectedUserSun = null;
            return;
        }

        var targetDate = Today.AddDays(index - todayIndex);
        var instantUtc = DateTime.SpecifyKind(targetDate.ToDateTime(LocalNoon) - _homeLocation.UtcOffset, DateTimeKind.Utc);

        _selectedHomeSun = SolarService.Calculate(instantUtc, _homeLocation);
        _selectedUserSun = UserLocation is null ? null : SolarService.Calculate(instantUtc, UserLocation);
    }

    private static string FormatTimeShort(TimeOnly? time) => time?.ToString("HH\\:mm") ?? "--:--";
}
